# Copia este fichero a .dev.vars y rellena los valores para desarrollo local.
# .dev.vars nunca se commitea (ver .gitignore). En producción, usar `wrangler secret put <NAME>`.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BETTER_AUTH_SECRET=
RESEND_API_KEY=
# Remitente de todos los correos (dominio de Factum verificado en Resend).
EMAIL_FROM=Factum <no-reply@factum.example>
# Opcional: dirección de respuesta para correos de sistema. Los documentos
# usan siempre el email de la empresa emisora como Reply-To.
EMAIL_REPLY_TO=
# URL pública de la app (enlaces en correos y retorno de Stripe Checkout).
APP_BASE_URL=http://localhost:3000

# Stripe Billing (claves de modo test en local; nunca en el repositorio).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pro contratable solo desde el Incremento 3. Mientras sea false, Pro aparece
# como «Próximamente» y el checkout lo rechaza con plan_not_available.
PRO_CHECKOUT_ENABLED=false
SENTRY_DSN=

# Solo integración: usa una base aislada; nunca reutilices DATABASE_URL.
INTEGRATION_DATABASE_URL=
# docker (exige INTEGRATION_POSTGRES_CONTAINER=invoice-flash-test-*) | neon | none
INTEGRATION_CLEANUP_TARGET=none
INTEGRATION_POSTGRES_CONTAINER=
NEON_PROJECT_ID=
INTEGRATION_NEON_BRANCH_ID=
NEON_API_KEY=
